Ref
%%%
class Ref {

    static valsToRefs(valList) {
        const { ValRef } = require('./ValRef');
        return valList.map(v => new ValRef(v));
    }

    deRef() {
        throw new Error("not implemented");
    }

    setRef(v) {
        throw new Error("not implemented");
    }
}

module.exports = { Ref };
%%%

ValRef
%%%
const { Ref } = require('./Ref');

class ValRef extends Ref {

    constructor(val) {
        super();
        this.val = val;
    }

    deRef() {
        return this.val;
    }

    setRef(v) {
        this.val = v;
        return v;
    }

    toString() {
        return `${this.val}`;
    }
}

module.exports = { ValRef };
%%%

ProcVal
%%%
const { Val } = require('./Val');
const { Bindings } = require('./Bindings');
const { Ref } = require('./Ref');
const { LanguageError } = require('./runtime/base');

class ProcVal extends Val {

    constructor(formals, body, env) {
        super();
        this.formals = formals;
        this.body = body;
        // Named procEnv, not env: Val declares an env() method (OBJ's
        // environment reflection, e.g. <f>x reads a closure's environment),
        // and an instance field named env would shadow it -- the same
        // collision Python has (see ProcVal in src/OBJ/python/spec.plcc).
        // Java keeps the field named env because it distinguishes fields
        // from methods and has no such collision.
        this.procEnv = env;
    }

    apply(args, env) {
        if (this.formals.symbolList.length !== args.length)
            throw new LanguageError("formals/args number mismatch");
        const refList = Ref.valsToRefs(args);
        const bindings = new Bindings(this.formals.symbolList, refList);
        const nenv = this.procEnv.extendEnvRef(bindings);
        return this.body.eval(nenv);
    }

    env() {
        return this.procEnv;
    }

    toString() {
        const formals = this.formals.symbolList.map(t => t.lexeme).join(",");
        return `proc(${formals})`;
    }
}

module.exports = { ProcVal };
%%%

ListVal
%%%
const { Val } = require('./Val');

class ListVal extends Val {

    // A static factory rather than a class field, for the same reason as
    // Val.nil(): the ListVal/ListNull import cycle would otherwise be
    // load-order dependent.
    static empty() {
        const { ListNull } = require('./ListNull');
        return new ListNull();
    }

    add(val) {
        const { ListNode } = require('./ListNode');
        return new ListNode(val, this);
    }

    isList() {
        return true;
    }

    listVal() {
        return this;
    }

    // shuttle this list onto dst
    shuttle(dst) {
        const { ListNode } = require('./ListNode');
        let src = this;
        while (src.isTrue()) {
            const node = src.listNode();
            dst = new ListNode(node.val, dst);
            src = node.rest;
        }
        return dst;
    }

    // reverse this list
    reverse() {
        return this.shuttle(ListVal.empty());
    }

    // append this list onto dst
    append(dst) {
        let src = this.shuttle(ListVal.empty());
        while (src.isTrue()) {
            const node = src.listNode();
            src = node.rest;
            node.rest = dst; // destructive ListNode operation
            dst = node;
        }
        return dst;
    }

    buildString(sb) {
        throw new Error("not implemented");
    }

    puts() {
        const sb = [];
        this.buildString(sb);
        return sb.join("");
    }

    // The separator-taking stringifier is named toStr rather than being an
    // overload of toString, which JavaScript cannot overload. Java keeps
    // toString(sep) as a genuine overload; Python names it toStr(sep) too.
    toStr(sep) {
        throw new Error("not implemented");
    }
}

module.exports = { ListVal };
%%%

ListNode
%%%
const { ListVal } = require('./ListVal');
const { LanguageError } = require('./runtime/base');

class ListNode extends ListVal {

    constructor(val, rest) {
        super();
        this.val = val;
        this.rest = rest; // the rest of the list
        this.len = rest.len + 1;
    }

    listNode() {
        return this;
    }

    buildString(sb) {
        let c;
        try {
            c = String.fromCharCode(this.val.intVal().val);
        } catch (e) {
            // JavaScript has no typed catch, so re-throw anything that is
            // not the LanguageError this is meant to translate.
            if (!(e instanceof LanguageError)) throw e;
            throw new LanguageError(`puts ...${this}... : not a string`);
        }
        sb.push(c);
        this.rest.buildString(sb);
    }

    toString() {
        return "[" + this.toStr("") + "]";
    }

    toStr(sep) {
        return sep + this.val + this.rest.toStr(",");
    }
}

module.exports = { ListNode };
%%%

