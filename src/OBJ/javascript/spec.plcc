EnvClass
%%%
const { Binding } = require('./Binding');
const { Bindings } = require('./Bindings');
const { ClassVal } = require('./ClassVal');
const { ObjectVal } = require('./ObjectVal');

// A "parentless" class whose static environment is the environment passed
// to its constructor.
class EnvClass extends ClassVal {

    // A static factory rather than a static field: Program is a generated
    // class, so evaluating Program.env when this class body loads would be
    // load-order dependent. It still returns bindings rooted at the one
    // Program.env object, so the singleton's real purpose survives.
    static envClass() {
        const { Program } = require('./Program');
        return new EnvClass(Program.env);
    }

    constructor(env) {
        super();
        this.staticEnv = env; // the environment inherited by all subclasses
    }

    env() {
        return this.staticEnv;
    }

    // Observe that the environment of objects created with 'new ...'
    // always extends the static environment of this class. The 'objRef'
    // reference will eventually be set to the object being created.
    makeObject(objRef) {
        // start with the static environment of this class
        let env = this.staticEnv;
        // add the field binding 'self' to refer to the base object (deep)
        const fieldBindings = new Bindings();
        env = env.extendEnvRef(fieldBindings); // this object's environment
        fieldBindings.add(new Binding("self", objRef)); // deep
        return new ObjectVal(env);
    }

    toString() {
        return "class";
    }
}

module.exports = { EnvClass };
%%%

StdClass
%%%
const { Binding } = require('./Binding');
const { Bindings } = require('./Bindings');
const { ClassVal } = require('./ClassVal');
const { ObjectVal } = require('./ObjectVal');
const { ValRef } = require('./ValRef');

class StdClass extends ClassVal {

    constructor(localEnv, superClass, statics, fields, methods) {
        // localEnv    the environment where this class is created
        // superClass  an EnvClass (top-level) or a StdClass, from ClassExp
        // statics     static variable definitions
        // fields      field declarations
        // methods     method definitions
        super();
        this.superClass = superClass;
        this.fields = fields;
        this.methods = methods;
        // this class's static environment extends the superclass environment
        let staticEnv = superClass.env();
        this.staticBindings = new Bindings(); // all statics go here
        staticEnv = staticEnv.extendEnvRef(this.staticBindings);
        this.staticEnv = staticEnv;
        // initially create bindings for these static symbols ... (order
        // matters: !@/myclass/superclass must be bound before
        // statics.addStaticBindings runs, since static RHS expressions may
        // reference them)
        const ref = new ValRef(new ObjectVal(localEnv));
        staticEnv.add(new Binding("!@", ref)); // not a var
        staticEnv.add(new Binding("myclass", new ValRef(this)));
        staticEnv.add(new Binding("superclass", new ValRef(superClass)));
        // The static RHS expressions are evaluated in the modified
        // staticEnv that includes the bindings for !@, myclass, superclass.
        // New static bindings are added as they are created, as in
        // top-level defines.
        statics.addStaticBindings(staticEnv);
    }

    env() {
        return this.staticEnv;
    }

    makeObject(objRef) {
        // create the parent object first (recursively)
        const parent = this.superClass.makeObject(objRef);

        // this object's environment extends the parent object's environment
        let env = parent.objectEnv;

        // add this class's static bindings (including myclass, etc)
        env = env.extendEnvRef(this.staticBindings);

        // the fields come next
        const fieldBindings = new Bindings();
        env = env.extendEnvRef(fieldBindings);
        // bind all of this object's instance fields to nil
        this.fields.addFieldBindings(fieldBindings);

        // bind all this object's methods as in letrec
        env = this.methods.addMethodBindings(env);

        // create the object
        const objectVal = new ObjectVal(env);

        // bind 'super' field to the parent object (order matters: fields
        // must be bound before super/self/this)
        fieldBindings.add(new Binding("super", new ValRef(parent)));
        // bind 'self' field to the base object being created
        // (to speed up lookups)
        fieldBindings.add(new Binding("self", objRef)); // deep
        // bind 'this' field to this object environment
        fieldBindings.add(new Binding("this", new ValRef(objectVal))); // shallow
        return objectVal;
    }

    toString() {
        return "class";
    }
}

module.exports = { StdClass };
%%%

ObjectVal
%%%
const { Val } = require('./Val');

// An object that captures the environment in which this object is created.
class ObjectVal extends Val {

    constructor(env) {
        super();
        this.objectEnv = env; // this object's environment
    }

    objectVal() {
        return this;
    }

    isObject() {
        return true;
    }

    env() {
        return this.objectEnv;
    }

    toString() {
        return "object";
    }
}

module.exports = { ObjectVal };
%%%

Reserved
%%%
const { LanguageError } = require('./runtime/base');

// Identifiers the object system binds implicitly.
//
// Binding one of these in user code does not shadow harmlessly: Bindings
// are appended and looked up first-match, and StdClass.makeObject binds
// fields *before* super/self/this, so a user `field self` silently wins
// every lookup and displaces the real self inside every method. The same
// goes for a method named self and for a static named myclass. Each is a
// silent wrong answer rather than an error, which is why this check
// exists and why it is called explicitly at each site rather than hidden
// inside Env.checkDuplicates.
class Reserved {

    static ids = ["self", "myclass", "superclass", "this", "super"];

    static check(symbolList) {
        for (const sym of symbolList)
            if (Reserved.ids.includes(sym.lexeme))
                throw new LanguageError("reserved ID: " + sym.lexeme);
    }
}

module.exports = { Reserved };
%%%

Program:import
%%%
const { Env } = require('./Env');
%%%

Program
%%%
static env = Env.initEnv();
// Output is buffered rather than printed. plcc-rep uses this program's
// stdout as a private line-oriented JSON channel, so a partial line
// written here merges with the result record and deadlocks the tool with
// no diagnostic. See issue 36. Every output expression appends to `out`;
// only _run() emits it, as part of its return value.
static out = [];
%%%

Eval
%%%
_run() {
    Program.out = [];
    const v = this.exp.eval(Program.env);
    return Program.out.join("") + String(v);
}
%%%

Define:import
%%%
const { Binding } = require('./Binding');
const { ValRef } = require('./ValRef');
%%%

Define
%%%
_run() {
    Program.out = [];
    const env = Program.env;
    const s = this.symbol.lexeme;
    const val = this.exp.eval(env);
    const ref = new ValRef(val);
    const b = env.lookup(s);
    if (b !== null)
        b.ref = ref;
    else
        env.add(new Binding(s, ref));
    return Program.out.join("") + s;
}
%%%

ExitExp
%%%
eval(env) {
    // Under old PLCC, rep *was* this process, so exit(0) was a clean quit.
    // Under plcc-ng the interpreter is a subprocess, so this closes the
    // protocol pipe: plcc-rep prints "interpreter exited unexpectedly" on
    // stderr and exits 1. Language semantics are unchanged. A clean-exit
    // record kind is requested upstream in issue 37.
    process.exit(0);
}
