%include ../grammar.plcc
%
javascript

%include ../../Env/envRef/javascript/env.plcc

Val
%%%
const { LanguageError } = require('./runtime/base');

class Val {

    // A static factory rather than a class field: evaluating it when the
    // class body loads would make the Val/NilVal import cycle load-order
    // dependent. Nothing compares Vals by identity, so a fresh NilVal each
    // time is equivalent.
    static nil() {
        const { NilVal } = require('./NilVal');
        return new NilVal();
    }

    // Some Vals can be applied to a list of arguments (e.g. a ProcVal).
    // Like the evaluation of an expression, the application of a Val takes
    // place in the context of an environment, which arrives as the second
    // parameter. An applied Val may use or ignore that environment as its
    // own semantics require.
    apply(args, env) {
        throw new LanguageError(`${this}: not a procedure`);
    }

    env() {
        throw new LanguageError(`<${this}>: not an environment`);
    }

    isTrue() {
        // every Val is true except for an IntVal of zero,
        // an empty list, or a NilVal.
        return true;
    }

    intVal() {
        throw new LanguageError(`${this}: not an Int`);
    }

    classVal() {
        throw new LanguageError(`${this}: not a Class`);
    }

    objectVal() {
        throw new LanguageError(`${this}: not an Object`);
    }

    isObject() {
        return false;
    }

    isClass() {
        return false;
    }

    isNil() {
        return false;
    }

    makeObject(objRef) {
        throw new LanguageError(`new ${this}: not a class`);
    }

    putc() {
        throw new LanguageError(`putc ${this}: not a character`);
    }

    puts() {
        throw new LanguageError(`puts ${this}: not a string`);
    }

    listNode() {
        throw new LanguageError(`${this}: not a nonempty List`);
    }

    listVal() {
        throw new LanguageError(`${this}: not a List`);
    }

    isList() {
        return false; // only ListVals are true
    }
}

module.exports = { Val };
%%%

IntVal
%%%
const { Val } = require('./Val');

class IntVal extends Val {

    constructor(val) {
        super();
        this.val = typeof val === "string" ? parseInt(val, 10) : val;
    }

    intVal() {
        return this;
    }

    isTrue() {
        return this.val !== 0;
    }

    putc() {
        return String.fromCharCode(this.val);
    }

    toString() {
        return String(this.val);
    }
}

module.exports = { IntVal };
%%%

NilVal
%%%
const { Val } = require('./Val');

class NilVal extends Val {

    isTrue() {
        return false;
    }

    isNil() {
        return true;
    }

    toString() {
        return "nil";
    }
}

module.exports = { NilVal };
