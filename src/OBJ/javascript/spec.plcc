AtAtExp:import
%%%
const { ObjectVal } = require('./ObjectVal');
const { Program } = require('./Program');
%%%

AtAtExp
%%%
eval(env) {
    // Buffered, never printed -- see the Program block. The trailing "\n"
    // reproduces System.out.println in old PLCC's src/OBJ/code:379-382
    // (deleted in this migration; see git history before d572089): Env's
    // own string already ends in a newline (EnvNull), so println emitted a
    // blank line after the dump. Dropping it would silently reflow the
    // output of every example that uses @@ (Prog/pobj, Prog/fig56). Do not
    // use console.log here: plcc-rep reserves stdout for its private JSON
    // protocol channel (issue 36), and a partial line would deadlock it
    // with no diagnostic -- output must stay buffered in Program.out like
    // every other output expression.
    Program.out.push(String(env) + "\n");
    return new ObjectVal(env);
}

toString() {
    return "@@";
}
%%%

DisplayExp:import
%%%
const { Program } = require('./Program');
const { Val } = require('./Val');
%%%

DisplayExp
%%%
eval(env) {
    const v = this.exp.eval(env);
    Program.out.push(String(v));
    return Val.nil();
}

toString() {
    return " ...DisplayExp... ";
}
%%%

