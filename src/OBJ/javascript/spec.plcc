IfExp
%%%
eval(env) {
    if (this.testExp.eval(env).isTrue())
        return this.trueExp.eval(env);
    else
        return this.falseExp.eval(env);
}

toString() {
    return `if ${this.testExp} then ${this.trueExp} else ${this.falseExp}`;
}
