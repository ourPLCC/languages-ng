%%%
eval(env) {
    const nenv = this.loc.getEnv(env);
    const ref = nenv.applyEnvRef(this.symbol.lexeme);
    const v = this.exp.eval(env);
    return ref.setRef(v);
}

toString() {
    return " ...SetExp... ";
}
