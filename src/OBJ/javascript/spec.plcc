ListExp:import
%%%
const { ListNode } = require('./ListNode');
const { ListVal } = require('./ListVal');
%%%

ListExp
%%%
eval(env) {
    const valList = this.rands.evalRands(env);
    let listVal = ListVal.empty();
    // process the elements in reverse order
    for (let i = valList.length - 1; i >= 0; i--)
        listVal = new ListNode(valList[i], listVal);
    return listVal;
}

toString() {
    return " ...ListExp... ";
}
