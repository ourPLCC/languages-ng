Statics:import
%%%
const { Binding } = require('./Binding');
const { Env } = require('./Env');
const { Reserved } = require('./Reserved');
const { ValRef } = require('./ValRef');
%%%

Statics:init
%%%
Env.checkDuplicates(this.symbolList, " in static variables");
Reserved.check(this.symbolList);
%%%

Statics
%%%
// Add new bindings to the static bindings -- behaves like top-level
// defines.
addStaticBindings(env) {
    for (let i = 0; i < this.symbolList.length; i++) {
        const val = this.expList[i].eval(env);
        env.add(new Binding(this.symbolList[i].lexeme, new ValRef(val)));
    }
}
%%%

Fields:import
%%%
const { Binding } = require('./Binding');
const { Env } = require('./Env');
const { Reserved } = require('./Reserved');
const { Val } = require('./Val');
const { ValRef } = require('./ValRef');
%%%

Fields:init
%%%
Env.checkDuplicates(this.symbolList, " in field variables");
Reserved.check(this.symbolList);
%%%

Fields
%%%
addFieldBindings(fieldBindings) {
    for (const t of this.symbolList)
        fieldBindings.add(new Binding(t.lexeme, new ValRef(Val.nil())));
}
%%%

Methods:import
%%%
const { Env } = require('./Env');
const { LetDecls } = require('./LetDecls');
const { ProcExp } = require('./ProcExp');
const { Reserved } = require('./Reserved');
%%%

Methods:init
%%%
Env.checkDuplicates(this.symbolList, " in method names");
Reserved.check(this.symbolList);
%%%

Methods
%%%
addMethodBindings(env) {
    if (this.symbolList.length === 0)
        return env;
    const expList = this.procList.map(p => new ProcExp(p));
    return new LetDecls(this.symbolList, expList).addLetrecBindings(env);
}
