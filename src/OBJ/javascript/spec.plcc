StrngExp:import
%%%
const { IntVal } = require('./IntVal');
const { ListVal } = require('./ListVal');
%%%

StrngExp
%%%
eval(env) {
    const ESCAPES = { a: 7, b: 8, t: 9, n: 10, f: 12, r: 13 };
    const s = this.strng.lexeme;
    // we know that s[0] and s[s.length - 1] are both '"'
    const end = s.length - 1;
    const codes = [];
    let pos = 1;
    while (pos < end) {
        let c = s[pos];
        pos += 1;
        if (c === "\\") {
            // escape!
            c = s[pos];
            pos += 1;
            codes.push(c in ESCAPES ? ESCAPES[c] : c.charCodeAt(0));
        } else {
            codes.push(c.charCodeAt(0));
        }
    }
    // build the ListVal back to front so it comes out in source order
    let lst = ListVal.empty();
    for (let i = codes.length - 1; i >= 0; i--)
        lst = lst.add(new IntVal(codes[i]));
    return lst;
}

toString() {
    return this.strng.lexeme;
}
