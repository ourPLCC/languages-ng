Ref
%%%
import java.util.ArrayList;
import java.util.List;

public abstract class Ref {

    public static List<Ref> valsToRefs(List<Val> valList) {
        List<Ref> refList = new ArrayList<Ref>(valList.size());
        for (Val v : valList)
            refList.add(new ValRef(v));
        return refList;
    }

    public abstract Val deRef();

    public abstract Val setRef(Val v);
}
%%%

ValRef
%%%
public class ValRef extends Ref {

    public Val val;

    public ValRef(Val val) {
        this.val = val;
    }

    public Val deRef() {
        return val;
    }

    public Val setRef(Val v) {
        val = v;
        return v;
    }

    public String toString() {
        return val.toString();
    }
}
%%%

ProcVal
%%%
import java.util.List;
import runtime.LanguageError;
import runtime.Token;

public class ProcVal extends Val {

    public Formals formals;
    public Exp body;
    // Named env, not procEnv: a Java instance field and an instance
    // method (Val.env()) may share a name without collision, so no
    // rename is needed here -- unlike Python and JavaScript, where an
    // instance attribute named env would shadow the env() method and
    // procEnv is used instead.
    public Env env;

    public ProcVal(Formals formals, Exp body, Env env) {
        this.formals = formals;
        this.body = body;
        this.env = env;
    }

    public Val apply(List<Val> args, Env e) {
        if (formals.symbolList.size() != args.size())
            throw new LanguageError("formals/args number mismatch");
        List<Ref> refList = Ref.valsToRefs(args);
        Bindings bindings = new Bindings(formals.symbolList, refList);
        Env nenv = env.extendEnvRef(bindings);
        return body.eval(nenv);
    }

    public Env env() {
        return env;
    }

    public String toString() {
        String ret = "proc(";
        String sep = "";
        for (Token t : formals.symbolList) {
            ret += sep + t.lexeme;
            sep = ",";
        }
        ret += ")";
        return ret;
    }
}
%%%

ListVal
%%%
public abstract class ListVal extends Val {

    // A static factory rather than a static field, for the same reason
    // as Val.nil(): kept as a method in every target for symmetry.
    public static ListVal empty() {
        return new ListNull();
    }

    public int len;

    public ListVal add(Val val) {
        return new ListNode(val, this);
    }

    public boolean isList() {
        return true;
    }

    public ListVal listVal() {
        return this;
    }

    // shuttle this list onto dst
    public ListVal shuttle(ListVal dst) {
        ListVal src = this;
        while (src.isTrue()) {
            ListNode node = src.listNode();
            dst = new ListNode(node.val, dst);
            src = node.rest;
        }
        return dst;
    }

    // reverse this list
    public ListVal reverse() {
        return this.shuttle(ListVal.empty());
    }

    // append this list onto dst
    public ListVal append(ListVal dst) {
        ListVal src = this.shuttle(ListVal.empty());
        while (src.isTrue()) {
            ListNode node = src.listNode();
            src = node.rest;
            node.rest = dst; // destructive ListNode operation
            dst = node;
        }
        return dst;
    }

    public abstract void buildString(StringBuilder sb);

    public String puts() {
        StringBuilder sb = new StringBuilder(len);
        buildString(sb);
        return sb.toString();
    }

    // The separator-taking stringifier is a genuine overload of
    // toString here; Python and JavaScript name it toStr(sep) because
    // neither language can overload __str__/toString.
    public abstract String toString(String sep);
}
%%%

ListNode
%%%
import runtime.LanguageError;

public class ListNode extends ListVal {

    public Val val;
    public ListVal rest; // the rest of the list

    public ListNode(Val val, ListVal rest) {
        this.val = val;
        this.rest = rest;
        this.len = rest.len + 1;
    }

    public ListNode listNode() {
        return this;
    }

    public void buildString(StringBuilder sb) {
        char c;
        try {
            c = (char) val.intVal().val;
        } catch (LanguageError e) {
            throw new LanguageError("puts ..." + this + "... : not a string");
        }
        sb.append(c);
        rest.buildString(sb);
    }

    public String toString() {
        return "[" + this.toString("") + "]";
    }

    public String toString(String sep) {
        return sep + val + rest.toString(",");
    }
}
