import java.util.ArrayList;
%%%

Eval
%%%
public String _run() {
    Program.out = new ArrayList<String>();
    Val v = exp.eval(Program.env);
    StringBuilder sb = new StringBuilder();
    for (String s : Program.out)
        sb.append(s);
    sb.append(v);
    return sb.toString();
}
%%%

Define:import
%%%
import java.util.ArrayList;
%%%

Define
%%%
public String _run() {
    Program.out = new ArrayList<String>();
    Env env = Program.env;
    String s = symbol.lexeme;
    Val val = exp.eval(env);
    Ref ref = new ValRef(val);
    Binding b = env.lookup(s);
    if (b != null)
        b.ref = ref;
    else
        env.add(new Binding(s, ref));
    StringBuilder sb = new StringBuilder();
    for (String out : Program.out)
        sb.append(out);
    sb.append(s);
    return sb.toString();
}
%%%

Val
%%%
import java.util.List;
import runtime.LanguageError;

public abstract class Val {

    // A static factory rather than a static field: Java could use a
    // static final field here, but the OBJ port keeps nil() as a method
    // in every target for symmetry with Python/JavaScript, where a class
    // attribute would create an import-cycle/load-order problem. Nothing
    // compares Vals by identity, so a fresh NilVal each time is
    // equivalent.
    public static Val nil() {
        return new NilVal();
    }

    public static Val [] toArray(List<Val> valList) {
        int n = valList.size();
        return valList.toArray(new Val[n]);
    }

    // Some Vals can be applied to a list of arguments (e.g. a ProcVal).
    // Like the evaluation of an expression, the application of a Val
    // takes place in the context of an environment, which arrives as the
    // second parameter. An applied Val may use or ignore that
    // environment as its own semantics require.
    public Val apply(List<Val> args, Env env) {
        throw new LanguageError(this + ": not a procedure");
    }

    public Env env() {
        throw new LanguageError("<" + this + ">: not an environment");
    }

    public boolean isTrue() {
        // every Val is true except for an IntVal of zero,
        // an empty list, or a NilVal.
        return true;
    }

    public IntVal intVal() {
        throw new LanguageError(this + ": not an Int");
    }

    public ClassVal classVal() {
        throw new LanguageError(this + ": not a Class");
    }

    public ObjectVal objectVal() {
        throw new LanguageError(this + ": not an Object");
    }

    public boolean isObject() {
        return false;
    }

    public boolean isClass() {
        return false;
    }

    public boolean isNil() {
        return false;
    }

    public ObjectVal makeObject(Ref objRef) {
        throw new LanguageError("new " + this + ": not a class");
    }

    public String putc() {
        throw new LanguageError("putc " + this + ": not a character");
    }

    public String puts() {
        throw new LanguageError("puts " + this + ": not a string");
    }

    public ListNode listNode() {
        throw new LanguageError(this + ": not a nonempty List");
    }

    public ListVal listVal() {
        throw new LanguageError(this + ": not a List");
    }

    public boolean isList() {
        return false; // only ListVals are true
    }
}
