public Val eval(Env env) {
    Val v = exp.eval(env);
    Program.out.add(v.toString());
    return Val.nil();
}

public String toString() {
    return " ...DisplayExp... ";
}
%%%

Display1Exp
%%%
public Val eval(Env env) {
    Val v = exp.eval(env);
    Program.out.add(v.toString() + " ");
    return Val.nil();
}

public String toString() {
    return " ...Display1Exp... ";
}
%%%

