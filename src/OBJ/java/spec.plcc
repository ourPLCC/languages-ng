Mangle
%%%
public Val eval(Val v, Env env) {
    // The message expression is evaluated in the *receiver's*
    // environment, while its operands are evaluated in the *caller's*
    // environment. The asymmetry is deliberate.
    for (int i = 0; i < expList.size(); i++) {
        Val p = expList.get(i).eval(v.env());
        List<Val> args = randsList.get(i).evalRands(env);
        v = p.apply(args, env);
    }
    return v;
}
