StrngExp:import
%%%
import java.util.LinkedList;
%%%

StrngExp
%%%
public Val eval(Env env) {
    String s = strng.lexeme;
    int len = s.length() - 1;
    LinkedList<Character> chars = new LinkedList<Character>();
    // We know that s.charAt(0) is '"' and that s.charAt(len) is '"'
    int pos = 1;
    while (pos < len) {
        char c = s.charAt(pos++);
        if (c == '\\') {
            // escape!
            c = s.charAt(pos++);
            switch (c) {
            case 'a' : c = 7; break;
            case 'b' : c = 8; break;
            case 't' : c = 9; break;
            case 'n' : c = 10; break;
            case 'f' : c = 12; break;
            case 'r' : c = 13; break;
            default  : break;
            }
        }
        chars.add(0, c); // add to beginning of list
    }
    // chars is in reverse order -- now build a ListVal in proper order
    ListVal lst = ListVal.empty();
    for (Character c : chars)
        lst = lst.add(new IntVal(c));
    return lst;
}

public String toString() {
    return strng.lexeme;
}
