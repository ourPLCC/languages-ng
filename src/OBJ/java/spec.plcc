Statics:init
%%%
Env.checkDuplicates(symbolList, " in static variables");
Reserved.check(symbolList);
%%%

Statics
%%%
// Add new bindings to the static bindings -- behaves like top-level
// defines.
public void addStaticBindings(Env env) {
    for (int i = 0; i < symbolList.size(); i++) {
        String s = symbolList.get(i).lexeme;
        Val val = expList.get(i).eval(env);
        env.add(new Binding(s, new ValRef(val)));
    }
}
%%%

Fields:init
%%%
Env.checkDuplicates(symbolList, " in field variables");
Reserved.check(symbolList);
%%%

Fields
%%%
public void addFieldBindings(Bindings fieldBindings) {
    for (Token t : symbolList)
        fieldBindings.add(new Binding(t.lexeme, new ValRef(Val.nil())));
}
%%%

Methods:import
%%%
import java.util.ArrayList;
import java.util.HashMap;
%%%

Methods:init
%%%
Env.checkDuplicates(symbolList, " in method names");
Reserved.check(symbolList);
%%%

Methods
%%%
// Java's generated grammar-derived classes expose only a
// Map<String,Object>-based constructor (Python's positional constructor
// has no Java counterpart), so ProcExp and LetDecls are built here by
// hand from field maps rather than by positional construction.
public Env addMethodBindings(Env env) {
    if (symbolList.size() == 0)
        return env;
    List<Exp> expList = new ArrayList<Exp>();
    for (Proc p : procList) {
        Map<String, Object> procExpFields = new HashMap<String, Object>();
        procExpFields.put("proc", p);
        expList.add(new ProcExp(procExpFields));
    }
    Map<String, Object> letDeclsFields = new HashMap<String, Object>();
    letDeclsFields.put("symbolList", symbolList);
    letDeclsFields.put("expList", expList);
    return new LetDecls(letDeclsFields).addLetrecBindings(env);
}
