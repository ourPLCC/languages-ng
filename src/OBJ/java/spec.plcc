Exp
%%%
public abstract Val eval(Env env);
%%%

ExitExp
%%%
public Val eval(Env env) {
    // Under old PLCC, rep *was* this process, so exit(0) was a clean
    // quit. Under plcc-ng the interpreter is a subprocess, so this
    // closes the protocol pipe: plcc-rep prints "interpreter exited
    // unexpectedly" on stderr and exits 1. Language semantics are
    // unchanged. A clean-exit record kind is requested upstream in
    // issue 37.
    System.exit(0);
    return Val.nil();
}
