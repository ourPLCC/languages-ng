AtAtExp
%%%
public Val eval(Env env) {
    // Buffered, never printed -- see the Program block. The trailing
    // "\n" reproduces System.out.println in old PLCC's
    // src/OBJ/code:379-382 (deleted in this migration; see git history
    // before d572089): Env's own string already ends in a newline
    // (EnvNull), so println emitted a blank line after the dump.
    // Dropping it would silently reflow the output of every example that
    // uses @@ (Prog/pobj, Prog/fig56).
    Program.out.add(env.toString() + "\n");
    return new ObjectVal(env);
}

public String toString() {
    return "@@";
}
