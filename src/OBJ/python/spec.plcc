Program:import
%%%
from Env import Env
%%%

Program
%%%
env = Env.initEnv()
# Output is buffered rather than printed. plcc-rep uses this program's
# stdout as a private line-oriented JSON channel, so a partial line
# written here merges with the result record and deadlocks the tool with
# no diagnostic (issue 36). Removing the buffering needs an output record
# kind from plcc-rep, which is issue 37 -- fixing issue 36 alone would
# only turn the deadlock into a diagnostic, with still nowhere to emit.
# Every output expression appends to `out`; only _run() emits it, as part
# of its return value.
out = []
%%%

Eval
%%%
def _run(self):
    Program.out = []
    v = self.exp.eval(Program.env)
    return "".join(Program.out) + str(v)
%%%

Define:import
%%%
from Binding import Binding
from ValRef import ValRef
%%%

Define
%%%
def _run(self):
    Program.out = []
    env = Program.env
    s = self.symbol.lexeme
    val = self.exp.eval(env)
    ref = ValRef(val)
    b = env.lookup(s)
    if b is not None:
        b.ref = ref
    else:
        env.add(Binding(s, ref))
    return "".join(Program.out) + s
%%%

Val
%%%
from runtime.base import LanguageError


class Val:

    # A static factory rather than a class attribute: a class attribute is
    # evaluated when the class body runs, which would make the Val/NilVal
    # import cycle load-order dependent. Nothing compares Vals by identity,
    # so a fresh NilVal each time is equivalent.
    @staticmethod
    def nil():
        from NilVal import NilVal
        return NilVal()

    # Some Vals can be applied to a list of arguments (e.g. a ProcVal).
    # Like the evaluation of an expression, the application of a Val takes
    # place in the context of an environment, which arrives as the second
    # parameter. An applied Val may use or ignore that environment as its
    # own semantics require.
    def apply(self, args, env):
        raise LanguageError(f"{self}: not a procedure")

    def env(self):
        raise LanguageError(f"<{self}>: not an environment")

    def isTrue(self):
        # every Val is true except for an IntVal of zero,
        # an empty list, or a NilVal.
        return True

    def intVal(self):
        raise LanguageError(f"{self}: not an Int")

    def classVal(self):
        raise LanguageError(f"{self}: not a Class")

    def objectVal(self):
        raise LanguageError(f"{self}: not an Object")

    def isObject(self):
        return False

    def isClass(self):
        return False

    def isNil(self):
        return False

    def makeObject(self, objRef):
        raise LanguageError(f"new {self}: not a class")

    def putc(self):
        raise LanguageError(f"putc {self}: not a character")

    def puts(self):
        raise LanguageError(f"puts {self}: not a string")

    def listNode(self):
        raise LanguageError(f"{self}: not a nonempty List")

    def listVal(self):
        raise LanguageError(f"{self}: not a List")

    def isList(self):
        return False  # only ListVals are true
%%%

IntVal
%%%
from Val import Val


class IntVal(Val):

    def __init__(self, val):
        self.val = int(val)

    def intVal(self):
        return self

    def isTrue(self):
        return self.val != 0

    def putc(self):
        return chr(self.val)

    def __str__(self):
        return str(self.val)
%%%

