from ListVal import ListVal


class ListNull(ListVal):

    def __init__(self):
        self.len = 0

    def isTrue(self):
        return False

    def buildString(self, sb):
        pass

    def __str__(self):
        return "[]"

    def toStr(self, sep):
        return ""
