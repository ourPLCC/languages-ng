Statics
%%%
# Add new bindings to the static bindings -- behaves like top-level
# defines.
def addStaticBindings(self, env):
    for sym, e in zip(self.symbolList, self.expList):
        val = e.eval(env)
        env.add(Binding(sym.lexeme, ValRef(val)))
