StrngExp:import
%%%
from IntVal import IntVal
from ListVal import ListVal
%%%

StrngExp
%%%
ESCAPES = {"a": 7, "b": 8, "t": 9, "n": 10, "f": 12, "r": 13}

def eval(self, env):
    s = self.strng.lexeme
    # we know that s[0] and s[-1] are both '"'
    end = len(s) - 1
    codes = []
    pos = 1
    while pos < end:
        c = s[pos]
        pos += 1
        if c == "\\":
            # escape!
            c = s[pos]
            pos += 1
            codes.append(StrngExp.ESCAPES.get(c, ord(c)))
        else:
            codes.append(ord(c))
    # build the ListVal back to front so it comes out in source order
    lst = ListVal.empty()
    for code in reversed(codes):
        lst = lst.add(IntVal(code))
    return lst

def __str__(self):
    return self.strng.lexeme
