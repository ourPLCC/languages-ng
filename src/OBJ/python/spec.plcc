AtAtExp:import
%%%
from ObjectVal import ObjectVal
from Program import Program
%%%

AtAtExp
%%%
def eval(self, env):
    # Buffered, never printed -- see the Program block. The trailing "\n"
    # reproduces System.out.println in old PLCC's src/OBJ/code:379-382
    # (deleted in this migration; see git history before d572089): Env's
    # own string already ends in a newline (EnvNull), so println emitted a
    # blank line after the dump. Dropping it would silently reflow the
    # output of every example that uses @@ (Prog/pobj, Prog/fig56).
    Program.out.append(str(env) + "\n")
    return ObjectVal(env)

def __str__(self):
    return "@@"
