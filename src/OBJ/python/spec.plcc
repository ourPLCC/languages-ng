EnvClass
%%%
from Binding import Binding
from Bindings import Bindings
from ClassVal import ClassVal
from ObjectVal import ObjectVal


# A "parentless" class whose static environment is the environment passed
# to its constructor.
class EnvClass(ClassVal):

    # The class extended by every other class. A static factory rather than
    # a static field: Program is a generated class, so evaluating
    # Program.env when this class body runs would be load-order dependent.
    # It still returns the one Program.env object, so the singleton's real
    # purpose survives.
    @staticmethod
    def envClass():
        from Program import Program
        return EnvClass(Program.env)

    def __init__(self, env):
        self.staticEnv = env  # the environment inherited by all subclasses

    def env(self):
        return self.staticEnv

    # Observe that the environment of objects created with 'new ...'
    # always extends the static environment of this class. The 'objRef'
    # reference will eventually be set to the object being created.
    def makeObject(self, objRef):
        # start with the static environment of this class
        env = self.staticEnv
        # add the field binding 'self' to refer to the base object (deep)
        fieldBindings = Bindings()
        env = env.extendEnvRef(fieldBindings)  # this object's environment
        fieldBindings.add(Binding("self", objRef))  # deep
        return ObjectVal(env)

    def __str__(self):
        return "class"
%%%

StdClass
%%%
from Binding import Binding
from Bindings import Bindings
from ClassVal import ClassVal
from ObjectVal import ObjectVal
from ValRef import ValRef


class StdClass(ClassVal):

    def __init__(self, localEnv, superClass, statics, fields, methods):
        # localEnv    the environment where this class is created
        # superClass  an EnvClass (top-level) or a StdClass, from ClassExp
        # statics     static variable definitions
        # fields      field declarations
        # methods     method definitions
        self.superClass = superClass
        self.fields = fields
        self.methods = methods
        # this class's static environment extends the superclass environment
        staticEnv = superClass.env()
        self.staticBindings = Bindings()  # all statics go here
        staticEnv = staticEnv.extendEnvRef(self.staticBindings)
        self.staticEnv = staticEnv
        # initially create bindings for these static symbols ...
        ref = ValRef(ObjectVal(localEnv))
        staticEnv.add(Binding("!@", ref))  # not a var
        staticEnv.add(Binding("myclass", ValRef(self)))
        staticEnv.add(Binding("superclass", ValRef(superClass)))
        # The static RHS expressions are evaluated in the modified
        # staticEnv that includes the bindings for !@, myclass, superclass.
        # New static bindings are added as they are created, as in
        # top-level defines.
        statics.addStaticBindings(staticEnv)

    def env(self):
        return self.staticEnv

    def makeObject(self, objRef):
        # create the parent object first (recursively)
        parent = self.superClass.makeObject(objRef)

        # this object's environment extends the parent object's environment
        env = parent.objectEnv

        # add this class's static bindings (including myclass, etc)
        env = env.extendEnvRef(self.staticBindings)

        # the fields come next
        fieldBindings = Bindings()
        env = env.extendEnvRef(fieldBindings)
        # bind all of this object's instance fields to nil
        self.fields.addFieldBindings(fieldBindings)

        # bind all this object's methods as in letrec
        env = self.methods.addMethodBindings(env)

        # create the object
        objectVal = ObjectVal(env)

        # bind 'super' field to the parent object
        fieldBindings.add(Binding("super", ValRef(parent)))
        # bind 'self' field to the base object being created
        # (to speed up lookups)
        fieldBindings.add(Binding("self", objRef))  # deep
        # bind 'this' field to this object environment
        fieldBindings.add(Binding("this", ValRef(objectVal)))  # shallow
        return objectVal

    def __str__(self):
        return "class"
%%%

ObjectVal
%%%
from Val import Val


# An object that captures the environment in which this object is created.
class ObjectVal(Val):

    def __init__(self, env):
        self.objectEnv = env  # this object's environment

    def objectVal(self):
        return self

    def isObject(self):
        return True

    def env(self):
        return self.objectEnv

    def __str__(self):
        return "object"
%%%

Reserved
%%%
from runtime.base import LanguageError


class Reserved:
    """Identifiers the object system binds implicitly.

    Binding one of these in user code does not shadow harmlessly: Bindings
    are appended and looked up first-match, and StdClass.makeObject binds
    fields *before* super/self/this, so a user `field self` silently wins
    every lookup and displaces the real self inside every method. The same
    goes for a method named self and for a static named myclass. Each is a
    silent wrong answer rather than an error, which is why this check
    exists and why it is called explicitly at each site rather than hidden
    inside Env.checkDuplicates.
    """

    ids = ["self", "myclass", "superclass", "this", "super"]

    @staticmethod
    def check(symbolList):
        for sym in symbolList:
            if sym.lexeme in Reserved.ids:
                raise LanguageError("reserved ID: " + sym.lexeme)
%%%

ExitExp
%%%
def eval(self, env):
    # Under old PLCC, rep *was* this process, so exit(0) was a clean quit.
    # Under plcc-ng the interpreter is a subprocess, so this closes the
    # protocol pipe: plcc-rep prints "interpreter exited unexpectedly" on
    # stderr and exits 1. Language semantics are unchanged. A clean-exit
    # record kind is requested upstream in issue 37.
    import sys
    sys.exit(0)
