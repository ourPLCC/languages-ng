Ref
%%%
class Ref:

    @staticmethod
    def valsToRefs(valList):
        from ValRef import ValRef
        return [ValRef(v) for v in valList]

    def deRef(self):
        raise NotImplementedError

    def setRef(self, v):
        raise NotImplementedError
%%%

ValRef
%%%
from Ref import Ref


class ValRef(Ref):

    def __init__(self, val):
        self.val = val

    def deRef(self):
        return self.val

    def setRef(self, v):
        self.val = v
        return v

    def __str__(self):
        return str(self.val)
%%%

ProcVal
%%%
from Bindings import Bindings
from Ref import Ref
from Val import Val
from runtime.base import LanguageError


class ProcVal(Val):

    def __init__(self, formals, body, env):
        self.formals = formals
        self.body = body
        # Named procEnv, not env: Val declares an env() method (OBJ's
        # environment reflection, e.g. <f>x reads a closure's environment),
        # and an instance attribute named env would shadow it in Python.
        self.procEnv = env

    def apply(self, args, env):
        if len(self.formals.symbolList) != len(args):
            raise LanguageError("formals/args number mismatch")
        refList = Ref.valsToRefs(args)
        bindings = Bindings(self.formals.symbolList, refList)
        nenv = self.procEnv.extendEnvRef(bindings)
        return self.body.eval(nenv)

    def env(self):
        return self.procEnv

    def __str__(self):
        formals = ",".join(t.lexeme for t in self.formals.symbolList)
        return f"proc({formals})"
%%%

ListVal
%%%
from Val import Val


class ListVal(Val):

    # A static factory rather than a class attribute, for the same reason
    # as Val.nil(): the ListVal/ListNull import cycle would otherwise be
    # load-order dependent.
    @staticmethod
    def empty():
        from ListNull import ListNull
        return ListNull()

    def add(self, val):
        from ListNode import ListNode
        return ListNode(val, self)

    def isList(self):
        return True

    def listVal(self):
        return self

    # shuttle this list onto dst
    def shuttle(self, dst):
        from ListNode import ListNode
        src = self
        while src.isTrue():
            node = src.listNode()
            dst = ListNode(node.val, dst)
            src = node.rest
        return dst

    # reverse this list
    def reverse(self):
        return self.shuttle(ListVal.empty())

    # append this list onto dst
    def append(self, dst):
        src = self.shuttle(ListVal.empty())
        while src.isTrue():
            node = src.listNode()
            src = node.rest
            node.rest = dst  # destructive ListNode operation
            dst = node
        return dst

    def buildString(self, sb):
        raise NotImplementedError

    def puts(self):
        sb = []
        self.buildString(sb)
        return "".join(sb)

    # The separator-taking stringifier is named toStr rather than being an
    # overload of __str__, which Python cannot overload. Java keeps
    # toString(String sep).
    def toStr(self, sep):
        raise NotImplementedError
%%%

ListNode
%%%
from ListVal import ListVal
from runtime.base import LanguageError


class ListNode(ListVal):

    def __init__(self, val, rest):
        self.val = val
        self.rest = rest  # the rest of the list
        self.len = rest.len + 1

    def listNode(self):
        return self

    def buildString(self, sb):
        try:
            c = chr(self.val.intVal().val)
        except LanguageError:
            raise LanguageError(f"puts ...{self}... : not a string")
        sb.append(c)
        self.rest.buildString(sb)

    def __str__(self):
        return "[" + self.toStr("") + "]"

    def toStr(self, sep):
        return sep + str(self.val) + self.rest.toStr(",")
%%%

