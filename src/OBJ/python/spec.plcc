Mangle
%%%
def eval(self, v, env):
    # The message expression is evaluated in the *receiver's* environment,
    # while its operands are evaluated in the *caller's* environment. The
    # asymmetry is deliberate.
    for e, rands in zip(self.expList, self.randsList):
        p = e.eval(v.env())
        args = rands.evalRands(env)
        v = p.apply(args, env)
    return v
