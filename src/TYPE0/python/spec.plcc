IfExp
%%%
def eval(self, env):
    if self.testExp.eval(env).isTrue():
        return self.trueExp.eval(env)
    else:
        return self.falseExp.eval(env)

def __str__(self):
    return f"if {self.testExp} then {self.trueExp} else {self.falseExp}"
