Program
%%%
env = Env.initEnv()
%%%

Define:import
%%%
from Binding import Binding
from ValRef import ValRef
%%%

Define
%%%
def _run(self):
    env = Program.env
    s = self.symbol.lexeme
    val = self.exp.eval(env)
    ref = ValRef(val)
    b = env.lookup(s)
    if b is not None:
        b.ref = ref
    else:
        env.add(Binding(s, ref))
    return s
%%%

Eval
%%%
def _run(self):
    return str(self.exp.eval(Program.env))
%%%

