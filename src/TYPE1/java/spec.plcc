AddPrim
%%%
public String toString() {
    return "+";
}

public Val apply(Val [] va) {
    if (va.length != 2)
        throw new LanguageError("two arguments expected");
    int i0 = va[0].intVal().val;
    int i1 = va[1].intVal().val;
    return new IntVal(i0 + i1);
}

public ProcType definedType() {
    return Type.ii_i();
}
