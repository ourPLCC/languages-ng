def apply(self, args):
    if len(args) != 2:
        raise LanguageError("two arguments expected")
    i0 = args[0].intVal().val
    i1 = args[1].intVal().val
    if i1 == 0:
        raise LanguageError("attempt to divide by zero")
    return IntVal(int(i0 / i1))

def definedType(self):
    return Type.ii_i()
