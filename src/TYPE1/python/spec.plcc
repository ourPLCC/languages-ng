SeqExp
%%%
def eval(self, env):
    v = self.exp.eval(env)
    for e in self.seqExps.expList:
        v = e.eval(env)
    return v

def evalType(self, tenv):
    t = self.exp.evalType(tenv)
    for e in self.seqExps.expList:
        t = e.evalType(tenv)
    return t

def __str__(self):
    return " ...SeqExp... "
