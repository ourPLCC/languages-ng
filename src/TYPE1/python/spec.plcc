SetExp
%%%
def eval(self, env):
    v = self.exp.eval(env)
    ref = env.applyEnvRef(self.symbol.lexeme)
    return ref.setRef(v)

def evalType(self, tenv):
    varType = tenv.applyTypeEnv(self.symbol.lexeme)
    expType = self.exp.evalType(tenv)
    varType.checkEquals(expType)
    return varType

def __str__(self):
    return " ...SetExp... "
